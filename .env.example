# Opcional. Sem chave, a busca do Google Books funciona, mas com cota menor.
# Crie uma chave em https://console.cloud.google.com (API "Books API") e
# salve este arquivo como .env
VITE_GOOGLE_BOOKS_KEY=
# Contas (Supabase). Os valores públicos já vêm no código; use isto só para apontar outro projeto.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
